---
// The shell every page sits in: <head>, fonts, and the shared base styles.
// Pages can pass a background colour; the home page sets its animated
// gradient in its own <style is:global> block instead.
interface Props {
  title: string;
  background?: string;
}

const { title, background } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@200;400;600&display=swap"
    />
    <!-- Nutshell v1.0.8 by Nicky Case (public domain, https://ncase.me/nutshell/).
         Any link whose text starts with ":" becomes an expandable explanation. -->
    <script is:inline src="./nutshell.js"></script>
    <script is:inline>
      Nutshell.setOptions({ dontEmbedHeadings: true });
    </script>
  </head>
  <body style={background ? `background-color: ${background};` : undefined}>
    <slot />
  </body>
</html>

<style is:global>
  body {
    font-family: 'Poppins', sans-serif;
    color: white;
  }
</style>
